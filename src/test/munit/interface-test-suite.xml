                description="Test main flow with APIKIT:BAD_REQUEST error"
                expectedErrorType="APIKIT:BAD_REQUEST">
        
        <munit:behavior>
            <munit-tools:mock-when processor="apikit:router" doc:name="Mock APIKit Router Error">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="inv-smtp-sapi-config" attributeName="config-ref" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="APIKIT:BAD_REQUEST" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload value='#[readUrl("classpath://interface/invalid-payload.json", "application/json")]' />
                <munit:attributes value='#[{
                    "headers": {
                        "content-type": "application/json",
                        "accept": "application/json"
                    },
                    "method": "POST",
                    "requestPath": "/api/v1/emailService"
                }]' />
            </munit:set-event>

            <flow-ref name="inv-smtp-sapi-main" />
        </munit:execution>
    </munit:test>

