            <munit-tools:mock-when processor="apikit:router" doc:name="Mock APIKit Router">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="inv-smtp-sapi-config" attributeName="config-ref" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[readUrl("classpath://interface/post-email-service-response.json", "application/json")]' />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload value='#[readUrl("classpath://interface/post-email-service-payload.json", "application/json")]' />
                <munit:attributes value='#[{
                    "headers": {
                        "content-type": "application/json",
                        "accept": "application/json",
                        "x-correlation-id": "test-correlation-id"
                    },
                    "method": "POST",
                    "requestPath": "/api/v1/emailService"
                }]' />
            </munit:set-event>

            <flow-ref name="inv-smtp-sapi-main" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[payload]"
                                   is='#[MunitTools::equalTo(readUrl("classpath://interface/post-email-service-response.json", "application/json"))]' />
            <munit-tools:assert-that expression="#[vars.correlationId]" 
                                   is="#[MunitTools::notNullValue()]" />
            <munit-tools:verify-call processor="apikit:router" atLeast="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="config-ref" whereValue="inv-smtp-sapi-config" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

