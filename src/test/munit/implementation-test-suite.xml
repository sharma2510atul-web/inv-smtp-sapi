    <!-- Test case for email body base64 decoding -->
    <munit:test name="implementation-smtp-base64-decoding-test" 
                description="Test email body base64 decoding functionality">
        
        <munit:behavior>
            <munit-tools:spy processor="ee:transform" doc:name="Spy Base64 Decoding">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Response Payload" attributeName="doc:name" />
                </munit-tools:with-attributes>
                <munit-tools:before-call>
                    <munit-tools:assert-that expression="#[payload.emailMessage]" 
                                           is="#[MunitTools::notNullValue()]" />
                </munit-tools:before-call>
                <munit-tools:after-call>
                    <munit-tools:assert-that expression="#[payload.message]" 
                                           is="#[MunitTools::containsString('Email sent to')]" />
                </munit-tools:after-call>
            </munit-tools:spy>
            
            <munit-tools:mock-when processor="email:send" doc:name="Mock Email Send">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Email_SMTP" attributeName="config-ref" />
                    <munit-tools:with-attribute whereValue="Send Email with Failed Record details" attributeName="doc:name" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload value='#[readUrl("classpath://implementation/email-success-payload.json", "application/json")]' />
                <munit:variables>
                    <munit:variable key="correlationId" value="test-correlation-id-base64" />
                </munit:variables>
            </munit:set-event>

            <flow-ref name="smtp-implementation-sub-flow" />
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that expression="#[payload]"
                                   is='#[MunitTools::equalTo(readUrl("classpath://implementation/email-success-response.json", "application/json"))]' />
        </munit:validation>
    </munit:test>

    <!-- Test case for correlation ID usage in logging -->
    <munit:test name="implementation-correlation-id-logging-test" 
                description="Test correlation ID is used properly in logging">
        
        <munit:behavior>
            <munit-tools:mock-when processor="email:send" doc:name="Mock Email Send">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute whereValue="Email_SMTP" attributeName="config-ref" />
