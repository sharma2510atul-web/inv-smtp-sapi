                                   is='#[MunitTools::equalTo(readUrl("classpath://implementation/email-success-response.json", "application/json"))]' />
            <munit-tools:assert-that expression="#[vars.correlationId]" 
                                   is="#[MunitTools::equalTo('test-correlation-id-logging')]" />
        </munit:validation>
    </munit:test>

</mule>
